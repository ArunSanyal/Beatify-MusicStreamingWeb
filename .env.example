# Copy this file to .env.local and fill in real values.
# These are read ONLY on the server. Never prefix them with NEXT_PUBLIC_.

# IAM user credentials (see README for the minimum permissions)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# S3 bucket that stores the uploaded MP3 files
S3_BUCKET_NAME=your-bucket-name

# CloudFront distribution in front of the bucket (no trailing slash)
CLOUDFRONT_URL=https://your-distribution-id.cloudfront.net

# DynamoDB table with partition key "pk" and sort key "sk" (both strings)
DYNAMODB_TABLE=your-table-name
